# Vertex custom-job config for a persona-battery worker.
#
# `imageUri`, `args`, and `scheduling.timeout` are placeholders here:
# cloud/render_job.py loads this file as YAML (not text), overwrites those
# fields with real Python values, and re-serializes it. In particular
# `args` is filled in as a genuine YAML list -- one element per flag/value
# -- never as a single string glued together with spaces. See
# cloud/render_job.py's module docstring for the defect that pattern used
# to cause. The `timeout` value below is never actually submitted as-is --
# render_job.py always overwrites it with its `--timeout` argument (default
# 7200s) -- it's set here only so the template is valid, runnable YAML on
# its own.
workerPoolSpecs:
  - machineSpec:
      machineType: a2-highgpu-2g
      acceleratorType: NVIDIA_TESLA_A100
      acceleratorCount: 2
    replicaCount: 1
    diskSpec:
      bootDiskType: pd-ssd
      bootDiskSizeGb: 400
    containerSpec:
      imageUri: __IMAGE_URI__
      command: [python, -m]
      args: []
scheduling:
  strategy: SPOT
  timeout: 7200s
  restartJobOnWorkerRestart: true
