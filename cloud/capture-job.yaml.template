# Vertex custom-job config for the activation-capture worker
# (personas.capture_main / Task 8).
#
# `imageUri` and `args` are placeholders here, exactly as in
# cloud/battery-job.yaml.template: fill them in as a real YAML list (one
# element per flag/value), never by gluing a multi-word string like
# "--arms A0 A3" onto one line with sed. That produces ONE YAML list
# element containing spaces; Vertex hands each `args` element to the
# container as a single argv token, so personas.capture_main's `argparse`
# (`--arms`/`--rungs`, both `nargs="+"`) would see one glued string instead
# of separate tokens and fail well into a paid A100 run. See
# cloud/render_job.py's module docstring for the original defect this
# describes (there for personas.runner) -- render_job.py itself is scoped
# to personas.runner today and does not render this template; either
# extend it or fill this file in by hand, but always as a proper list.
#
# personas.capture_main's CLI:
#   --output OUTPUT_DIR          (required; local scratch dir, e.g. /tmp/activations)
#   --gcs-prefix GCS_PREFIX      (optional; gs://... -- enables resume-from-GCS
#                                 and per-capture upload; see personas/gcs.py)
#   --arms ARM_ID [ARM_ID ...]   (required; paired positionally with --rungs --
#                                 the Nth rung goes with the Nth arm, e.g.
#                                 --arms A0 A3 --rungs L1 L2 captures (A0, L1)
#                                 and (A3, L2) only, not the 2x2 cross product)
#   --rungs RUNG [RUNG ...]      (required; same length as --arms)
#
# Every one of the model's 64 decoder layers is captured for each (arm,
# rung, item) -- never a stride-4 subset, which on this model's hybrid
# attention (48 linear-attention + 16 full-attention layers, full attention
# at indices 3, 7, 11, ... 63) would sample linear-attention layers
# exclusively and silently miss every full-attention layer. See
# personas/activations.py's module docstring. At 640KB/position/prompt this
# job's disk and upload footprint stays trivial even at the full battery
# size, so this is a deliberate non-optimization.
workerPoolSpecs:
  - machineSpec:
      machineType: a2-highgpu-2g
      acceleratorType: NVIDIA_TESLA_A100
      acceleratorCount: 2
    replicaCount: 1
    diskSpec:
      bootDiskType: pd-ssd
      bootDiskSizeGb: 400
    containerSpec:
      imageUri: __IMAGE_URI__
      command: [python, -m]
      args: []
scheduling:
  strategy: SPOT
  timeout: 7200s
  restartJobOnWorkerRestart: true
